<h1>Secret Word</h1>
<form method="POST" action="/secretword">
  <input name="secretWord" value="<%= secretWord %>" placeholder="Secret Word" />
  <button>Save</button>
</form>

<ul>
  <% errors.forEach(e => { %><li style="color:red"><%= e %></li><% }) %>
  <% info.forEach(i => { %><li style="color:green"><%= i %></li><% }) %>
</ul>
