<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Books</title>
  <style>
    table {
      border-collapse: collapse;
      width: 100%;
      margin-top: 1em;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 0.5em 1em;
      text-align: left;
    }
    th {
      background: #f0f0f0;
    }
    .actions {
      white-space: nowrap;
    }
    .msg-error { color: red; }
    .msg-info { color: green; }
    form.inline { display: inline; }
    .search-bar {
      margin-bottom: 1em;
    }
    .top-bar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 1em;
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <form action="/sessions/logout" method="POST">
      <button type="submit">Logoff</button>
    </form>
  </div>

  <h1>Books</h1>

  <!-- Search Form -->
  <form method="GET" action="/books/search" class="search-bar">
    <input type="text" name="title" placeholder="Search by title" value="<%= typeof search !== 'undefined' ? search : '' %>" />
    <button type="submit">Search</button>
    <% if (typeof search !== 'undefined' && search) { %>
      <a href="/books">Clear</a>
    <% } %>
  </form>

  <!-- Add Book Form -->
  <form method="POST" action="/books/add" style="margin-bottom: 2em;">
    <fieldset>
      <legend>Add Book</legend>
      <label>Title: <input name="title" required /></label>
      <label>Author: <input name="author" required /></label>
      <label>Genre:
        <select name="genre">
          <option value="Fiction">Fiction</option>
          <option value="Nonfiction">Nonfiction</option>
          <option value="Fantasy">Fantasy</option>
          <option value="Sci-Fi">Sci-Fi</option>
          <option value="Biography">Biography</option>
          <option value="Other" selected>Other</option>
        </select>
      </label>
      <label>Published:
        <input name="publishedDate" type="date" />
      </label>
      <label>Rating:
        <input name="rating" type="number" min="1" max="5" value="3" />
      </label>
      <label>
        <input type="checkbox" name="isPublic" value="true" /> Public
      </label>
      <label>Tags:
        <input name="tags" placeholder="Tags (comma separated)" />
      </label>
      <button type="submit">Add Book</button>
    </fieldset>
  </form>

  <!-- Error and Info Messages -->
  <% if (errors && errors.length) { %>
    <ul>
      <% errors.forEach(e => { %><li class="msg-error"><%= e %></li><% }) %>
    </ul>
  <% } %>
  <% if (info && info.length) { %>
    <ul>
      <% info.forEach(i => { %><li class="msg-info"><%= i %></li><% }) %>
    </ul>
  <% } %>

  <!-- Book List Table -->
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Genre</th>
        <th>Published</th>
        <th>Rating</th>
        <th>Public</th>
        <th>Tags</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% books.forEach(book => { %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.author %></td>
          <td><%= book.genre %></td>
          <td><%= book.publishedDate ? book.publishedDate.toISOString().slice(0,10) : 'N/A' %></td>
          <td><%= book.rating %></td>
          <td><%= book.isPublic ? 'Yes' : 'No' %></td>
          <td><%= book.tags && book.tags.length ? book.tags.join(', ') : 'None' %></td>
          <td class="actions">
            <a href="/books/edit/<%= book._id %>">Edit</a>
            <form action="/books/delete/<%= book._id %>" method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this book?');">
              <button type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>